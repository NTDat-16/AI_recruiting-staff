# Application Settings
PROJECT_NAME="AI Recruiting Platform"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL + pgvector)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/recruiting_db"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recruiting_db"
USE_SQLITE=false

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# S3 / MinIO Object Storage
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="recruiting-artifacts"
S3_REGION="us-east-1"

# AI Providers Configuration
# LLM_PROVIDER options: 'anthropic' | 'openai' | 'mock'
LLM_PROVIDER="mock"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Speech-to-Text Provider
# STT_PROVIDER options: 'whisper' | 'assemblyai' | 'mock'
STT_PROVIDER="mock"
WHISPER_API_KEY=""
ASSEMBLYAI_API_KEY=""

# Email Provider
EMAIL_PROVIDER="mock"
SENDGRID_API_KEY=""
DEFAULT_FROM_EMAIL="recruitment@ai-recruiting.internal"
